# Database Configuration
POSTGRES_PASSWORD=postgres123
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/news_sentiment
MONGODB_URI=mongodb://localhost:27017/news_articles
REDIS_URL=redis://localhost:6379/0

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
# Get free key from: https://ai.google.dev/

# Optional: For future paid features
OPENAI_API_KEY=your_openai_api_key_here
NEWSAPI_KEY=your_newsapi_key_here

# Application Settings
ENVIRONMENT=development
SECRET_KEY=your-secret-key-change-in-production
API_PORT=8000
FRONTEND_PORT=3000

# ML Model Settings
MODEL_CACHE_DIR=./models
USE_GPU=false

# Scraper Settings
SCRAPE_INTERVAL_TOP_TICKERS=300  # 5 minutes in seconds
SCRAPE_INTERVAL_OTHER_TICKERS=3600  # 1 hour in seconds

# Feature Flags
ENABLE_LLM_CALIBRATION=true
LLM_CONFIDENCE_THRESHOLD=0.7  # Only calibrate if confidence < this
ENABLE_RECENCY_SCORING=true

# Logging
LOG_LEVEL=INFO
