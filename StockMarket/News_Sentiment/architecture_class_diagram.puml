@startuml News_Sentiment_Analysis_Platform

' ========================================
' STYLING - Clean Professional White Theme
' ========================================
skinparam classAttributeIconSize 0
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #333333
    ArrowColor #555555
    FontColor #000000
    FontSize 11
    BorderThickness 1.5
    AttributeFontSize 10
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8F9FA
skinparam packageBorderColor #999999
skinparam packageBorderThickness 2
skinparam packageFontSize 13
skinparam packageFontStyle bold
skinparam stereotypeCBackgroundColor #E8E8E8
skinparam stereotypeFontColor #333333
skinparam linetype ortho

' ========================================
' FRONTEND LAYER
' ========================================
package "Frontend Layer" {
    
    class FrontendApp <<JavaScript>> {
        currentTicker: string
        stockListCache: Array
        loadingState: boolean
        --
        +initializeApp(): void
        +fetchNews(): Promise
        +renderNewsCards(): void
        +handleSearch(): void
        +formatTimestamp(): string
    }
    
    class LoaderModule <<JavaScript>> {
        canvas: HTMLCanvasElement
        candlesticks: Array
        --
        +initLoader(): void
        +animateCandlesticks(): void
        +showLoader(): void
        +hideLoader(): void
    }
}

' ========================================
' BACKEND API LAYER
' ========================================
package "Backend API Layer" {
    
    class FastAPIApp {
        title: string
        version: string
        routers: List
        --
        +startup_event(): void
        +shutdown_event(): void
        +include_router(): void
    }
}

' ========================================
' DATA SCHEMAS
' ========================================
package "Data Schemas" {
    
    class ArticleIngestRequest <<Pydantic>> {
        ticker: str
        title: str
        url: str
        source: str
        published_at: datetime
        text: str
    }
    
    class SentimentResponse <<Pydantic>> {
        ticker: str
        sentiment_score: float
        label: str
        confidence: float
        explanation: str
        key_entities: List[str]
    }
    
    class NewsArticleResponse <<Pydantic>> {
        id: str
        ticker: str
        title: str
        url: str
        source: str
        published_at: datetime
        sentiment: SentimentResponse
    }
    
    class TickerSearchResponse <<Pydantic>> {
        symbol: str
        name: str
        sector: str
        market_cap: float
    }
}

' ========================================
' DATABASE MODELS
' ========================================
package "Database Models" {
    
    class Ticker <<SQLAlchemy>> {
        id: Integer
        symbol: String
        name: String
        sector: String
        market_cap: Float
        exchange: String
    }
    
    class SentimentResult <<SQLAlchemy>> {
        id: Integer
        article_id: String
        ticker: String
        sentiment_score: Float
        label: String
        confidence: Float
        finbert_score: Float
        lexicon_score: Float
    }
    
    class RecencyScore <<SQLAlchemy>> {
        id: Integer
        article_id: String
        ticker: String
        recency_score: Float
        actual_return: Float
        predicted_return: Float
    }
    
    class PriceHistory <<SQLAlchemy>> {
        id: Integer
        ticker: String
        timestamp: DateTime
        open: Float
        high: Float
        low: Float
        close: Float
        volume: Integer
    }
    
    class DatabaseConfig {
        engine: Engine
        mongodb: MongoClient
        redis_client: Redis
        --
        +get_db(): Session
    }
}

' ========================================
' ML/AI PIPELINE
' ========================================
package "ML Pipeline" {
    
    class SentimentAnalyzer {
        w1: float = 0.75
        w2: float = 0.00
        w3: float = 0.25
        enable_llm: bool
        --
        +analyze(): Dict
        -_generate_explanation(): str
    }
    
    class FinBERTModel {
        model_name: str
        device: torch.device
        tokenizer: AutoTokenizer
        model: AutoModel
        --
        +predict(): Dict
    }
    
    class LexiconModel {
        positive_words: Set[str]
        negative_words: Set[str]
        positive_patterns: List[str]
        negative_patterns: List[str]
        --
        +score(): float
        -_detect_patterns(): float
        -_detect_magnitude(): float
        +get_stats(): Dict
    }
    
    class FinancialPreprocessor {
        event_keywords: Dict
        negation_words: List[str]
        --
        +clean(): str
        +enhance(): Dict
    }
    
    class EntityExtractor {
        stock_patterns: List[regex]
        company_variants: Dict
        --
        +extract_tickers(): List[Dict]
        +extract_companies(): List[str]
    }
    
    class LLMCalibrator {
        api_key: str
        model: str
        temperature: float
        --
        +calibrate(): float
    }
    
    class ConfidenceEstimator {
        w_agreement: float = 0.40
        w_language: float = 0.25
        w_source: float = 0.20
        w_event: float = 0.15
        source_trust: Dict[str, float]
        --
        +calculate(): float
    }
    
    class SentimentHelper <<Singleton>> {
        _analyzer: SentimentAnalyzer
        --
        +get_sentiment(): Dict
    }
}

' ========================================
' SCRAPER LAYER
' ========================================
package "News Scrapers" {
    
    class ScanXGoogleScraper {
        stock_mapping: Dict[str, str]
        csv_path: str
        --
        +fetch_all_scanx_news(): List[Dict]
        +fetch_scanx_news_for_ticker(): List[Dict]
        +fetch_fresh_news(): List[Dict]
        +get_company_name(): str
        -_clean_company_name(): str
    }
    
    class GoogleNewsPlaywrightScraper {
        stock_mapping: Dict[str, str]
        browser: Browser
        page: Page
        --
        +scrape_all_news(): List[Dict]
        +scrape_ticker_news(): List[Dict]
        -_extract_articles(): List[Dict]
        +close(): void
    }
}

' ========================================
' TASK QUEUE
' ========================================
package "Task Queue" {
    
    class CeleryApp {
        broker_url: str
        result_backend: str
        beat_schedule: Dict
        --
        +task(): decorator
    }
    
    class SentimentTask {
        analyzer: SentimentAnalyzer
        --
        +analyze_sentiment_task(): Dict
    }
    
    class ScraperTask {
        scraper: ScanXGoogleScraper
        top_tickers: List[str]
        --
        +scrape_news_task(): Dict
    }
    
    class RecencyTask {
        +calculate_recency_task(): Dict
    }
}

' ========================================
' CONFIGURATION
' ========================================
package "Configuration" {
    
    class Settings {
        ENVIRONMENT: str
        API_PORT: int
        DATABASE_URL: str
        MONGODB_URL: str
        REDIS_URL: str
        GEMINI_API_KEY: str
        --
        +load_from_env(): Settings
        +validate(): bool
    }
}

' ========================================
' RELATIONSHIPS
' ========================================

' Frontend to Backend
FrontendApp --> FastAPIApp : HTTP Requests
FrontendApp --> LoaderModule : uses

' Backend Layer
FastAPIApp --> APIRouters : includes
APIRouters ..> NewsArticleResponse : returns
APIRouters ..> SentimentResponse : returns
APIRouters ..> TickerSearchResponse : returns

' Backend to ML
FastAPIApp --> SentimentHelper : calls

' Backend to Scrapers
FastAPIApp --> GoogleNewsPlaywrightScraper : uses
FastAPIApp --> ScanXGoogleScraper : uses

' Backend to Database
FastAPIApp --> DatabaseConfig : uses
DatabaseConfig --> Ticker : manages
DatabaseConfig --> SentimentResult : manages
DatabaseConfig --> RecencyScore : manages
DatabaseConfig --> PriceHistory : manages

' ML Pipeline Components
SentimentAnalyzer --> FinBERTModel : uses (75%)
SentimentAnalyzer --> LexiconModel : uses (25%)
SentimentAnalyzer --> LLMCalibrator : calibrates
SentimentAnalyzer --> ConfidenceEstimator : calculates
SentimentAnalyzer --> FinancialPreprocessor : preprocesses
SentimentAnalyzer --> EntityExtractor : extracts
SentimentHelper --> SentimentAnalyzer : wraps

' Task Queue
CeleryApp --> SentimentTask : schedules
CeleryApp --> ScraperTask : schedules
CeleryApp --> RecencyTask : schedules
SentimentTask --> SentimentAnalyzer : uses
SentimentTask --> DatabaseConfig : stores
ScraperTask --> ScanXGoogleScraper : uses
ScraperTask --> DatabaseConfig : stores
RecencyTask --> DatabaseConfig : stores

' Configuration
FastAPIApp --> Settings : uses
CeleryApp --> Settings : uses

' Scraper Dependencies
ScanXGoogleScraper ..> Ticker : reads CSV
GoogleNewsPlaywrightScraper ..> Ticker : reads CSV

@enduml
