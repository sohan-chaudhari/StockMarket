# =============================================================================
# ENVIRONMENT EXAMPLE FILE
# Copy this to `.env` and fill in your real credentials.
# NEVER commit the real `.env` file to version control.
# =============================================================================

# Database
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_data

# JWT — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string

# Email (SMTP) — Optional, used for email verification
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Angel One LIVE price API
ANGELONE_API_KEY=your_api_key
ANGELONE_CLIENT_ID=your_client_id
ANGELONE_PASSWORD=your_password
ANGELONE_TOTP_TOKEN=your_totp_secret
